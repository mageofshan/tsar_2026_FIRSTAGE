//Climber Class – Java Pseudocode
class Climber {

    Motor climberMotor
    DigitalInput topLimitSwitch
    DigitalInput bottomLimitSwitch

    function climbUp() {
        if (topLimitSwitch NOT pressed) {
            set climberMotor to 1.0
        } else {
            stop()
        }
    }

    function climbDown() {
        if (bottomLimitSwitch NOT pressed) {
            set climberMotor to -1.0
        } else {
            stop()
        }
    }

    function stop() {
        set climberMotor to 0
    }
}


//Robot Class – Java Pseudocode
class Robot {

    Climber climber
    Controller driverController
    Timer matchTimer

    function robotInit() {
        start matchTimer
    }

    function autonomousPeriodic() {

        run autonomous driving code

        // End of Autonomous climb (last 3 seconds of auto)
        if (matchTimer >= 12 seconds) {
            climber.climbUp()
        }
    }

    function teleopPeriodic() {

        // Manual Control
        if (driverController A button pressed) {
            climber.climbUp()
        }
        else if (driverController B button pressed) {
            climber.climbDown()
        }
        else {
            climber.stop()
        }

        // Endgame Auto Climb (last 20 seconds of match)
        if (matchTimer >= 130 seconds) {
            climber.climbUp()
        }
    }
}
